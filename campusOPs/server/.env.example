# ==============================================================================
# CampusOps Server Environment Variables (Render & Local)
# ==============================================================================

# Server port (Render assigns this automatically, defaults to 5000 locally)
PORT=5000

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Python Intelligence Microservice (FastAPI on Render or localhost)
# Example on Render: https://campusops-ai.onrender.com
# Example locally: http://localhost:8000
INTELLIGENCE_URL=http://localhost:8000

# Blockchain / Web3 Bridge (Optional)
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
AUDIT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
